<?xml version="1.0" encoding="ISO-8859-1"?>
<OpenGeoSysProject>
    <meshes>
        <mesh>domain.vtu</mesh>
        <mesh>boundary.vtu</mesh>
        <mesh>inj.vtu</mesh>
        <mesh>prod.vtu</mesh>
    </meshes>
    <processes>
        <process>
            <name>hc</name>
            <type>ComponentTransport</type>
            <integration_order>2</integration_order>
            <non_advective_form>false</non_advective_form>
            <process_variables>
                <concentration>Tracer</concentration>
                <pressure>pressure</pressure>
            </process_variables>
            <specific_body_force>0 0</specific_body_force>
            <secondary_variables>
                <secondary_variable internal_name="darcy_velocity" output_name="darcy_velocity"/>
            </secondary_variables>
            <numerical_stabilization>
                <type>IsotropicDiffusion</type>
                <cutoff_velocity>0</cutoff_velocity>
                <tuning_parameter>0.5</tuning_parameter>
            </numerical_stabilization>
        </process>
    </processes>
    <media>
        <medium id="0">
            <phases>
                <phase>
                    <type>AqueousLiquid</type>
                    <components>
                        <component>
                            <name>Tracer</name>
                            <properties>
                                <property><name>pore_diffusion</name><type>Constant</type><value>1e-09</value></property>
                                <property><name>retardation_factor</name><type>Constant</type><value>1</value></property>
                                <property><name>decay_rate</name><type>Constant</type><value>0</value></property>
                            </properties>
                        </component>
                    </components>
                    <properties>
                        <property><name>density</name><type>Constant</type><value>1000.0</value></property>
                        <property><name>viscosity</name><type>Constant</type><value>0.001</value></property>
                    </properties>
                </phase>
            </phases>
            <properties>
                <property><name>permeability</name><type>Constant</type><value>1.1798240646354815e-12</value></property>
                <property><name>porosity</name><type>Constant</type><value>0.3</value></property>
                <property><name>longitudinal_dispersivity</name><type>Constant</type><value>2.0</value></property>
                <property><name>transversal_dispersivity</name><type>Constant</type><value>0.2</value></property>
                <property><name>storage</name><type>Constant</type><value>0</value></property>
            </properties>
        </medium>
    </media>
    <time_loop>
        <processes>
            <process ref="hc">
                <nonlinear_solver>basic_picard</nonlinear_solver>
                <convergence_criterion>
                    <type>PerComponentDeltaX</type>
                    <norm_type>NORM2</norm_type>
                    <reltols>1e-6 1e-8</reltols>
                </convergence_criterion>
                <time_discretization><type>BackwardEuler</type></time_discretization>
                <time_stepping>
                    <type>FixedTimeStepping</type>
                    <t_initial>0</t_initial>
                    <t_end>68601600.0</t_end>
                    <timesteps><pair><repeat>794</repeat><delta_t>86400.0</delta_t></pair></timesteps>
                </time_stepping>
            </process>
        </processes>
        <output>
            <type>VTK</type>
            <prefix>pattern</prefix>
            <timesteps><pair><repeat>100000</repeat><each_steps>5</each_steps></pair></timesteps>
            <variables>
                <variable>Tracer</variable>
                <variable>pressure</variable>
                <variable>darcy_velocity</variable>
            </variables>
        </output>
    </time_loop>
    <parameters>
        <parameter><name>p0</name><type>Constant</type><value>200000</value></parameter>
        <parameter><name>p_bc</name><type>Function</type><expression>200000 - 19.62*x</expression></parameter>
        <parameter><name>c0</name><type>Constant</type><value>0</value></parameter>
        <parameter><name>c_inj</name><type>Constant</type><value>250.0</value></parameter>
        <parameter><name>q_inj_on</name><type>Constant</type><value>0.14467592592592593</value></parameter>
        <parameter><name>q_inj</name><type>CurveScaled</type><curve>inj_schedule</curve><parameter>q_inj_on</parameter></parameter>
        <parameter><name>q_prod</name><type>Constant</type><value>-0.08680555555555555</value></parameter>
    </parameters>
    <process_variables>
        <process_variable>
            <name>pressure</name>
            <components>1</components>
            <order>1</order>
            <initial_condition>p0</initial_condition>
            <boundary_conditions>
                <boundary_condition><mesh>boundary</mesh><type>Dirichlet</type><parameter>p_bc</parameter></boundary_condition>
            </boundary_conditions>
            <source_terms>
                <source_term><mesh>inj</mesh><type>Nodal</type><parameter>q_inj</parameter></source_term>
                <source_term><mesh>prod</mesh><type>Nodal</type><parameter>q_prod</parameter></source_term>
            </source_terms>
        </process_variable>
        <process_variable>
            <name>Tracer</name>
            <components>1</components>
            <order>1</order>
            <initial_condition>c0</initial_condition>
            <boundary_conditions>
                <boundary_condition><mesh>inj</mesh><type>DirichletWithinTimeInterval</type><parameter>c_inj</parameter>
                    <time_interval><start>0</start><end>48960000.0</end></time_interval></boundary_condition>
            </boundary_conditions>
        </process_variable>
    </process_variables>
    <curves>
        <!-- 침출(주입 켬) → t_leach 이후 복원(주입 끔, 양수는 계속) -->
        <curve><name>inj_schedule</name><coords>0 48960000.0 48960001.0 137289600.0</coords><values>1 1 0 0</values></curve>
    </curves>
    <nonlinear_solvers>
        <nonlinear_solver>
            <name>basic_picard</name>
            <type>Picard</type>
            <max_iter>25</max_iter>
            <linear_solver>general_linear_solver</linear_solver>
        </nonlinear_solver>
    </nonlinear_solvers>
    <linear_solvers>
        <linear_solver>
            <name>general_linear_solver</name>
            <eigen>
                <solver_type>SparseLU</solver_type>
                <scaling>true</scaling>
            </eigen>
        </linear_solver>
    </linear_solvers>
</OpenGeoSysProject>
